{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/get-started",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/assets/aica-ad.mp4",
      "destination": "/assets/aica/aica-film.mp4",
      "statusCode": 301
    },
    {
      "source": "/assets/aica/aica-poster.jpg",
      "destination": "/assets/aica/aica-poster.webp",
      "statusCode": 301
    },
    {
      "source": "/assets/bg.png",
      "destination": "/assets/contact-hands.webp",
      "statusCode": 301
    },
    {
      "source": "/assets/akashimg.jpg",
      "destination": "/assets/akash.webp",
      "statusCode": 301
    },
    {
      "source": "/assets/akashimg-480.jpg",
      "destination": "/assets/akash-480.webp",
      "statusCode": 301
    },
    {
