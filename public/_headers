# Cache policy, read by Netlify and Cloudflare Pages. Other hosts ignore the
# file; the same two rules belong in their own config if you move.
#
# Everything under /assets is content-hashed by Vite, so a changed file is a
# changed URL and the old one can be kept forever. The HTML that points at them
# is the opposite: it must be re-checked every visit or a deploy never lands.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.glb
  Cache-Control: public, max-age=31536000, immutable

/logo.png
  Cache-Control: public, max-age=604800

/og-cover.png
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
